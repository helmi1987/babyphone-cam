# babyphone-cam - your values; compose.yaml stays as it is. Comments only on lines of their own.
# Special characters ($ # " or trailing spaces): in single quotes, e.g. PARENT_PIN='a$b#c'

# Image tag: latest (main), a version like 1.0.0, or a branch name
BABYPHONE_VERSION=latest

# Own address of the container in your LAN (br0), e.g. 192.168.1.30
BABYPHONE_IP=

# PINs (must differ)
PARENT_PIN=
CHILD_PIN=
# Fixed child names, comma-separated (a free name is always possible)
CHILD_NAMES=
# Allowed client networks; empty = all private ranges (LAN + typical VPN)
ALLOWED_CIDRS=
# Extra host names the page answers to, e.g. babyphone.example.org
HOSTS=
# Address for Unraid's WebUI button
WEBUI=https://babyphone.example.org/

# Appdata folder (cookie secret, Cert Warden cache); owned by PUID:PGID
DATA_DIR=/mnt/user/appdata/babyphone
PUID=99
PGID=100

# HTTPS option A: certificate folder (read-only), e.g. NPM's letsencrypt folder
CERTS_DIR=/mnt/user/appdata/Nginx-Proxy-Manager-Official/letsencrypt
# Optional explicit files inside the container, e.g. /certs/live/npm-5/fullchain.pem
TLS_CERT=
TLS_KEY=

# HTTPS option B: Cert Warden (replaces option A), e.g. https://certwarden.example.org:4050
CERTWARDEN_ENDPOINT_URL=
CERT_NAME=
CERT_CERT_API=
CERT_KEY_API=
CERT_CHECK_DAY=30

# Media port (UDP + TCP)
RTC_PORT=40000

# Seconds: offline after no heartbeat / alarm delay / removed from list / alarm unacked
HEARTBEAT_TIMEOUT=20
ALARM_DELAY=30
OFFLINE_TIMEOUT=600
ALARM_UNACKED_DELAY=60
# Detection: sound level 0-100, motion % changed pixels
SOUND_THRESHOLD=25
MOTION_THRESHOLD=4

# Webhooks. Placeholders: {event} {name} {title} {message} {time}
# Events: child_offline,child_online,alarm_unacked,parent_offline,no_parent,test (empty = all)
# Send event "test" once at start: 1
WEBHOOK_TEST=
# Example Gotify:
# WEBHOOK_1_URL=https://gotify.lan/message?token=XYZ
# WEBHOOK_1_METHOD=POST
# WEBHOOK_1_HEADERS=Content-Type: application/json
# WEBHOOK_1_BODY={"title":"{title}","message":"{message}","priority":8}
# Example Bark (internet service):
# WEBHOOK_2_URL=https://api.day.app/YOURKEY/{title}/{message}
# WEBHOOK_2_METHOD=GET
# Example Slack (internet service):
# WEBHOOK_3_URL=https://hooks.slack.com/services/XXX
# WEBHOOK_3_HEADERS=Content-Type: application/json
# WEBHOOK_3_BODY={"text":"{title}: {message}"}
WEBHOOK_1_URL=
WEBHOOK_1_METHOD=POST
WEBHOOK_1_HEADERS=
WEBHOOK_1_BODY=
WEBHOOK_1_EVENTS=
WEBHOOK_2_URL=
WEBHOOK_2_METHOD=POST
WEBHOOK_2_HEADERS=
WEBHOOK_2_BODY=
WEBHOOK_2_EVENTS=
WEBHOOK_3_URL=
WEBHOOK_3_METHOD=POST
WEBHOOK_3_HEADERS=
WEBHOOK_3_BODY=
WEBHOOK_3_EVENTS=
