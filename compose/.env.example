# babyphone-cam - your values; compose.yaml stays as it is. Comments only on lines of their own.
# Everything not listed here (PINs, child names, HTTPS, alarms, webhooks, network) is set in
# the web UI: the first-start wizard opens on the first visit, later via "Einstellungen".
# Special characters ($ # " or trailing spaces): in single quotes, e.g. ADMIN_PIN='1234'

# Image tag: latest (main), a version like 1.0.0, or a branch name
BABYPHONE_VERSION=latest

# Own address of the container in your LAN (br0), e.g. 192.168.1.30
BABYPHONE_IP=
# Address for Unraid's WebUI button
WEBUI=https://babyphone.example.org/

# Appdata folder (settings.json, cookie secret, Cert Warden cache); owned by PUID:PGID
DATA_DIR=/mnt/user/appdata/babyphone
PUID=99
PGID=100
TZ=

# Certificate folder (read-only), e.g. NPM's letsencrypt folder
CERTS_DIR=/mnt/user/appdata/Nginx-Proxy-Manager-Official/letsencrypt

# Optional start values; leave empty to set them in the wizard (digits, at least 4, all different).
# A value saved in the web UI wins over these.
ADMIN_PIN=
PARENT_PIN=
CHILD_PIN=
